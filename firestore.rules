rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // Allow users to read/write rides they're involved in
    match /rides/{rideId} {
      allow read, write: if resource == null || 
         resource.data.riderId == request.auth.uid || 
        resource.data.driverId == request.auth.uid;
    }
    
    // Allow users to read/write their own ride requests
    match /ride_requests/{requestId} {
      // Allow riders to create and update their own rides
      allow create: if request.resource.data.riderId == request.auth.uid;
      
      // Allow riders to update their own rides and drivers to accept/update rides
      allow update: if resource.data.riderId == request.auth.uid ||
         resource.data.driverId == request.auth.uid ||
         (resource.data.status == 'pending' && 
          request.resource.data.driverId == request.auth.uid) ||
         // Allow any user to update declinedDrivers field for pending rides
         (resource.data.status == 'pending');
      
      allow delete: if resource.data.riderId == request.auth.uid;
      
      // Allow read access for users
      allow read: if resource == null || 
         resource.data.riderId == request.auth.uid || 
         resource.data.driverId == request.auth.uid ||
         resource.data.status == 'pending';
    }
    
    // Allow users to read/write their own wallet
    match /wallets/{walletId} {
      allow read, write: if resource == null || resource.data.userId == request.auth.uid;
    }
    
    // Allow users to read/write their own feedback
    match /feedback/{feedbackId} {
      allow read, write: if resource == null || 
         resource.data.fromUserId == request.auth.uid || 
         resource.data.toUserId == request.auth.uid;
    }
    
    // Allow users to read/write their own ratings
    match /user_ratings/{ratingId} {
      allow read, write: if resource == null || resource.data.userId == request.auth.uid;
    }
    
    // Allow users to read/write their own payments
    match /payments/{paymentId} {
      allow read, write: if resource == null || resource.data.userId == request.auth.uid;
    }
    
    // Allow users to read/write their own saved payment methods
    match /saved_payment_methods/{methodId} {
      allow read, write: if resource == null || resource.data.userId == request.auth.uid;
    }
    
    // Allow users to read/write their own carpool rides and discover available carpools
    match /carpool_rides/{carpoolId} {
      // Allow users to read available carpool rides for discovery
      allow read: if resource.data.status == 'pending' || 
         resource.data.driverId == request.auth.uid || 
         resource.data.riders[request.auth.uid] != null;
      
      // Allow users to write if they're the driver or a rider
      allow write: if resource == null || 
         resource.data.driverId == request.auth.uid || 
         resource.data.riders[request.auth.uid] != null;
    }
    
    // Allow users to read/write their own carpool riders
    match /carpool_riders/{riderId} {
      allow read, write: if resource == null || 
         resource.data.driverId == request.auth.uid || 
         resource.data.riderId == request.auth.uid;
    }
    
    // Allow users to read/write their own carpool stops
    match /carpool_stops/{stopId} {
      allow read, write: if resource == null || 
         resource.data.carpoolId in get(/databases/$(database)/documents/carpool_rides/$(resource.data.carpoolId)).data.riders[request.auth.uid];
    }
    
    // Allow users to read/write their own carpool requests
    match /carpool_requests/{requestId} {
      allow read: if resource == null || 
         resource.data.requesterId == request.auth.uid ||
         resource.data.carpoolRideId != null;
      
      allow create: if request.resource.data.requesterId == request.auth.uid;
      
      allow update: if resource.data.requesterId == request.auth.uid ||
         resource.data.carpoolRideId != null;
      
      allow delete: if resource.data.requesterId == request.auth.uid;
    }
    
    // Allow users to read/write their own notification settings
    match /notification_settings/{settingId} {
      allow read, write: if resource == null || resource.data.userId == request.auth.uid;
    }
    
    // Allow users to read/write their own system configurations
    match /system_config/{configId} {
      allow read: if true;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
